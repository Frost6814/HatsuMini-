#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NUMBER  1
#define FN  2
#define HOTKEY  3

/ {
    combos {
        compatible = "zmk,combos";

        QW {
            timeout-ms = <50>;
            key-positions = <2 1>; // KP: VB
            bindings = <&kp RS(LC(TILDE))>;
            layers = <0>;
        };

        lay4 {
            bindings = <&lt 3 F>;
            key-positions = <15 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp CAPSLOCK  &mt TILDE Q  &kp W  &kp E                   &kp R               &kp T        &kp Y      &kp U                   &kp I      &kp O    &mt DELETE P             &kp LEFT_BRACKET
&kp TAB       &kp A        &kp S  &kp D                   &lt 3 F             &lt 4 G      &kp H      &kp J                   &kp K      &kp L    &kp SEMI                 &mt TILDE SQT
&kp LSHFT     &kp Z        &kp X  &kp C                   &kp V               &kp B        &kp N      &kp M                   &kp COMMA  &kp DOT  &mt LS(BACKSLASH) SLASH  &kp RIGHT_BRACKET
                                  &mt LCTRL LS(LEFT_ALT)  &mt LEFT_ALT SPACE  &lt 1 ENTER  &lt 2 ESC  &mt LEFT_GUI BACKSPACE  &none
            >;
        };

        number_layer {
            label = "NUMBER";
            bindings = <
&kp F1     &kp F2           &kp F3       &kp F4            &kp F5        &kp F6       &kp F7     &kp F8         &kp F9        &kp F10               &kp F11                &mt PRINTSCREEN F12
&mkp MCLK  &kp N1           &kp N2       &kp N3            &kp N4        &kp N5       &kp N6     &kp N7         &kp N8        &kp N9                &kp N0                 &kp MINUS
&kp LSHFT  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH          &kp DOLLAR    &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &mt EQUAL PLUS
                                         &kp LS(LEFT_ALT)  &kp LEFT_ALT  &kp LCTRL    &mkp LCLK  &mkp RCLK      &none
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
&sys_reset  &none         &kp UP_ARROW    &none          &none         &bt BT_CLR    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS      &kp C_PREV         &kp C_NEXT
&none       &kp LEFT      &kp DOWN_ARROW  &kp RIGHT      &none         &out OUT_USB  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD    &kp K_MUTE         &kp C_PP
&kp HOME    &kp C_BRI_DN  &kp C_BRI_UP    &kp C_AC_FIND  &bt BT_SEL 0  &out OUT_BLE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
                                          &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &none         &bt BT_SEL 4  &none
            >;
        };

        hotkey_layer {
            label = "HOTKEY";
            bindings = <
&none           &none         &none         &none      &none      &none      &none  &none  &none  &none  &none  &none
&kp LEFT_SHIFT  &none         &none         &none      &none      &none      &none  &none  &none  &none  &none  &none
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT  &none      &none      &none      &none  &none  &none  &none  &none  &none
                                            &mkp MCLK  &mkp LCLK  &mkp RCLK  &none  &none  &none
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans
                        &mkp MCLK  &mkp LCLK  &mkp RCLK  &none   &none   &none
            >;
        };
    };
};
